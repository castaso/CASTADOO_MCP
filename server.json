{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.castaso/castadoo-mcp",
  "description": "CASTADOO MCP: gated writes, multi-instance, 41 tools. Fork of odoo-mcp (MIT).",
  "version": "1.3.2",
  "websiteUrl": "https://https://github.com/castaso/CASTADOO_MCP#readme",
  "repository": {
    "url": "https://github.com/castaso/CASTADOO_MCP",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "castadoo-mcp",
      "version": "1.3.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ODOO_URL",
          "description": "Odoo server URL, e.g. https://mycompany.odoo.com",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "ODOO_DB",
          "description": "Odoo database name",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "ODOO_USERNAME",
          "description": "Odoo login (email)",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "ODOO_PASSWORD",
          "description": "Odoo password or API key",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
